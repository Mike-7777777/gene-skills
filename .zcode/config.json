{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/hook-context-wrap.sh\" SessionStart .zcode/hooks/session-start.sh",
              "timeout": 20
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/hook-context-wrap.sh\" SessionStart .zcode/hooks/detect-gaps.sh",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "compact|clear",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/scoped-rules.sh\" --reset",
              "timeout": 5
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-commit.sh\"",
              "timeout": 15
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-push.sh\"",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-registry.sh\"",
              "timeout": 15
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-write.sh\"",
              "timeout": 15
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/scoped-rules.sh\"",
              "timeout": 5
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-read.sh\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/scoped-rules.sh\"",
              "timeout": 5
            }
          ]
        },
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/log-agent.sh\"",
              "timeout": 5
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-assets.sh\"",
              "timeout": 10
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-skill-change.sh\"",
              "timeout": 5
            }
          ]
        },
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/log-agent-stop.sh\"",
              "timeout": 5
            },
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/validate-agent-artifact.sh\"",
              "timeout": 10
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/session-stop.sh\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
